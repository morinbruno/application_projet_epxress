<!DOCTYPE html>
<html lang="fr" class="h-100" data-bs-theme="dark">
    <!-- Début du Head -->
      <%- include('../../partials/head') %>
    <!-- Fin du Head -->    
<body class="d-flex h-100 justify-content-center align-items-center">
  <div class="p-4 rounded border shadow mx-5 bg-light-subtle" style="width: 400px;">
    <h2 class="mb-4 pb-3 border-bottom text-center">Se connecter</h2>
    <form class="form-floating" method="post" action="/se-connecter">
      <!-- Pseudo/Email -->
      <div class="input-group mb-3 px-auto has-validation">
        <span class="input-group-text"><i class="fa-solid fa-user"></i></span>
        <div class="form-floating <%- invalid_user ? "is-invalid" : "" %>">
          <input type="text" class="form-control <%- invalid_user ? "is-invalid" : "" %>" id="user_email" name="user_email" placeholder="name@example.com" required>
          <label for="user_email">Pseudo/Email</label>
        </div>
        <div class="invalid-feedback">
          <% if(invalid_user) { %>
            L'utilisateur n'existe pas
          <% } %>
        </div>
      </div>
      <!-- Mot de passe -->
      <div class="input-group has-validation mb-3">
        <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
        <div class="form-floating <%- invalid_mdp ? "is-invalid" : "" %>">
          <input type="password" class="form-control <%- invalid_mdp ? "is-invalid" : "" %>" id="password" name="password" placeholder="Mot de passe" required>
          <label for="password">Mot de passe</label>
        </div>
        <div class="invalid-feedback">
          <% if(invalid_mdp) { %>
            Le mot de passe ne correspond pas
          <% } %>
        </div>
      </div>
      <!-- Se créer un compte -->
      <div class="mb-2">
        <a href="/creer-compte" class="link">Créer un compte</a>
      </div>
      <!-- Envoie de demande de connexion -->
      <button type="submit" class="btn btn-primary w-100">Se connecter</button>
    </form>
    </div>
    <div class="position-absolute bottom-0 end-0 me-5 mb-5">
      <%- include('../../partials/change_theme') %>
    </div>
</body>
</html>