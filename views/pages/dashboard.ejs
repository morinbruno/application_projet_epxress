<!DOCTYPE html>
<html lang="fr">
<%- include('../partials/head') %>

<body class="bg-dark">
  <!-- Header -->
  <%- include('../partials/header') %>
  <!-- Header -->
  <div class="container mt-5" style="height: 100vh;">
    <!-- Ajout d'un produit -->
    <div class="container mb-5 text-white shadow rounded border p-3" style="background-color: #343a40;">
      <h1 class="text-white mb-3 border-bottom pb-3">Ajouter un produit</h1>
      <form class="row m-0">
        <div class="col-auto">
          <label for="produit" class="col-form-label">Produit</label>
        </div>
        <div class="col-auto">
          <input type="text" class="form-control" id="produit" name="produit">
        </div>
      </form>
    </div>
    <!-- Gestionnaire des produits -->
    <div class="container mb-5 text-white shadow rounded border p-3" style="background-color: #343a40;">
      <h1 class="text-white mb-3 border-bottom pb-3">Tableau des produits</h1>
      <% if (resultat == undefined || resultat.length == 0) {%>
      <div class="alert alert-info mt-3 shadow">Votre gestion alimentaire est vide</div>
      <% } else { %>
      <div class="overflow-auto">
        <table class="table table-dark table-striped border">
          <thead class="align-middle">
            <th scope="col">Produit</th>
            <th scope="col">Quantité</th>
            <th scope="col">Catégorie</th>
            <th scope="col">Magasin</th>
            <th scope="col">Date d'achat</th>
            <th scope="col">Date d'expiration</th>
            <th scope="col">Etat du produit</th>
            <th scope="col">Actions</th>
          </thead>
          <tbody>
            <% for(i = 0; i < resultat.length; i++){ %>
            <tr class="align-middle">
              <form>
                <td><span data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="<%- resultat[i]['nom_categorie'] %>"><%- resultat[i]['nom_produit'] %></span></td>
                <td><%- resultat[i]['quantite'] %></td>
                <td><%- resultat[i]['nom_categorie'] %></td>
                <td><span data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="<%- resultat[i]['nom_localite'] %>"><%- resultat[i]['nom_magasin'] %></span></td>
                <td><%- date_local(resultat[i]['date_achat']) %></td>
                <td><%- date_local_input(resultat[i]['date_expiration']) %></td>
                <td><%- date_peremption_etat(date_local(resultat[i]['date_expiration'])) %></td>
                <td>
                  <a href="#" class="btn btn-primary me-2"><i class="fa-solid fa-pen"></i></a>
                  <a href="/supprimer-produit?id=<%- resultat[i]['id_produit'] %>" class="btn btn-danger"><i class="fa-solid fa-trash"></i></a>
                </td>
              </form>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
  </div>
  <!-- Footer -->
  <%- include('../partials/footer') %>
  <!-- Footer -->
  <script>
    const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]')
    const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl))
  </script>
  <script type="module">
    import {
      Toast
    } from '/assets/bootstrap/js/bootstrap.esm.min.js'

    Array.from(document.querySelectorAll('.toast'))
      .forEach(toastNode => new Toast(toastNode))
  </script>
</body>

</html>