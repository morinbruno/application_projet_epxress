<!DOCTYPE html>
<html lang="fr">
<%- include('../partials/head') %>

<body class="bg-dark">
  <!-- Header -->
  <%- include('../partials/header') %>
  <!-- Header -->
  <div class="container mt-5" style="height: 100vh;">
    <!-- Ajout d'un produit -->
    <div class="container mb-5 text-white shadow rounded border p-3" style="background-color: #343a40;">
      <h1 class="text-white mb-3 border-bottom pb-3">Ajouter un produit</h1>
      <form class="row m-0">
        <div class="col-auto">
          <label for="produit" class="col-form-label">Produit</label>
        </div>
        <div class="col-auto">
          <input type="text" class="form-control" id="produit" name="produit">
        </div>
      </form>
    </div>
    <!-- Gestionnaire des produits -->
    <div class="container mb-5 text-white shadow rounded border p-3" style="background-color: #343a40;">
      <h1 class="text-white mb-3 border-bottom pb-3">Tableau des produits</h1>
      <% if (useralimentaire == undefined || useralimentaire.length == 0) {%>
      <div class="alert alert-info mt-3 shadow">Votre gestion alimentaire est vide</div>
      <% } else { %>
      <table class="table table-dark table-striped border mt-3">
        <thead>
          <th>Produit</th>
          <th>Quantité</th>
          <th>Date d'achat</th>
          <th>Date d'expiration</th>
          <th>Etat du produit</th>
          <th>Actions</th>
        </thead>
        <tbody>
          <% for(i=0; i<useralimentaire.length; i++){ %>
          <tr class="align-middle h">
            <form>
              <td><input class="form-control w-auto" type="text" value="<%- useralimentaire[i]['nom_produit'] %>"></td>
              <td><input class="form-control w-auto" type="text" value="<%- useralimentaire[i]['quantite'] %>"></td>
              <td><input type="date" class="form-control w-auto" value="<%- (useralimentaire[i]['date_achat'].toLocaleDateString('JPN', { year: "numeric", month: '2-digit', day: '2-digit'})).replaceAll('/','-') %>"></td>
              <td><input type="date" class="form-control w-auto" value="<%- (useralimentaire[i]['date_expiration'].toLocaleDateString('JPN', { year: "numeric", month: '2-digit', day: '2-digit'})).replaceAll('/','-') %>"></td>
              <td><%- new Date().toLocaleDateString() < new Date(useralimentaire[i]['date_expiration']).toLocaleDateString() ? "Bon" : "Périmé"%></td>
              <td>
                <a href="#" class="btn btn-primary me-2"><i class="fa-solid fa-pen"></i></a>
                <a href="/supprimer-produit?id=<%- useralimentaire[i]['id_produit'] %>" class="btn btn-danger"><i class="fa-solid fa-trash"></i></a>
              </td>
            </form>
          </tr>
          <% } %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>
  <!-- Footer -->
  <%- include('../partials/footer') %>
  <!-- Footer -->
</body>

</html>