<!DOCTYPE html>
<html lang="fr" data-bs-theme="dark">
<!-- Début du Head -->
<%- include('../partials/head') %>
<!-- Fin du Head -->

<body>
  <!-- Header -->
  <%- include('../partials/header') %>
  <!-- Header -->
  <div class="container mt-4">
    <!-- Ajout d'un produit -->
    <div class="container mb-5 shadow rounded border p-3 bg-light-subtle">
      <h1 class="mb-3 border-bottom pb-3"><i class="fa-solid fa-plus fs-2 me-3"></i>Ajouter un produit</h1>
      <form class="m-0 form-floating gap-3 mb-3" method="post" action="/ajouter-produit">
        <div class="row row-cols-md-2 m-0 mb-3 gap-3">
          <!-- Nom du produit -->
          <div class="form-floating p-0 col-md-3">
            <input type="text" class="form-control" placeholder="Produit" id="produit" name="produit" required>
            <label class="col-form-label" for="produit">Produit</label>
          </div>
          <!-- Quantité du produit -->
          <div class="col-md-3 p-0">
            <div class="input-group has-validation">
              <div class="form-floating <%- quantite_invalid ? "is-invalid" : "" %>">
                <input type="text" class="form-control <%- quantite_invalid ? "is-invalid" : "" %>" placeholder="Quantité" id="quantite" name="quantite" required>
                <label for="quantite">Quantité</label>
              </div>
              <div class="invalid-feedback">
                Quantité invalide !
              </div>
            </div>
          </div>
          <!-- Catégorie du produit -->
          <div class="form-floating p-0 col-md-3">
            <select class="form-select" id="categorie" name="categorie" aria-label="Catégorie" required>
              <% if (list_categorie == undefined) { %>
              <option selected>Aucune catégorie disponible</option>
              <% } else { %>
              <option selected>Choississez la catégorie</option>
              <% for(i = 0; i < list_categorie.length; i++){ %>
              <option value="<%- list_categorie[i]['code_categorie'] %>"><%- list_categorie[i]['nom_categorie'] %></option>
              <% }} %>
            </select>
            <label for="floatingSelect">Catégorie</label>
          </div>
          <!-- Date d'achat -->
          <div class="form-floating p-0 col-md-3">
            <input type="date" class="form-control" placeholder="Date d'achat" id="date_achat" name="date_achat" required>
            <label class="col-form-label" for="date_achat">Date d'achat</label>
          </div>
          <!-- Date d'expiration -->
          <div class="form-floating p-0 col-md-3">
            <input type="date" class="form-control" placeholder="Date d'expiration" id="date_expiration" name="date_expiration" required>
            <label class="col-form-label" for="date_expiration">Date d'expiration</label>
          </div>
          <!-- Magasin -->
          <div class="form-floating p-0 col-md-3">
            <select class="form-select" id="magasin" name="magasin" aria-label="Magasin" required>
              <% if (list_magasin == undefined) { %>
              <option selected>Aucune magasin disponible</option>
              <% } else { %>
              <option selected>Choississez le magasin</option>
              <% for(i = 0; i < list_magasin.length; i++){ %>
              <option value="<%- list_magasin[i]['id_magasin'] %>"><%- list_magasin[i]['nom_magasin'] %></option>
              <% }} %>
            </select>
            <label for="floatingSelect">Magasin</label>
          </div>
          <!-- Ville du magasin -->
          <div class="form-floating p-0 col-md-3">
            <select class="form-select" id="localite" name="localite" aria-label="Localité" required>
              <% if (list_localite == undefined) { %>
              <option selected>Aucune ville disponible</option>
              <% } else { %>
              <option selected>Choississez la ville</option>
              <% for(i = 0; i < list_localite.length; i++){ %>
              <option value="<%- list_localite[i]['code_postal'] %>"><%- list_localite[i]['nom_localite'] %></option>
              <% }} %>
            </select>
            <label for="floatingSelect">Ville</label>
          </div>
        </div>
        <!-- Bouton d'ajout du produit -->
        <div class="row row-cols-auto m-0 gap-3">
          <button type="submit" class="btn btn-primary" id="ajout_produit">Ajouter</button>
          <% if(produit_manquant) { %>
          <div class="alert alert-warning p-1 m-0"><i class="fa-solid fa-warning me-2"></i>Informations manquantes !</div>
          <% } %>
        </div>
      </form>
    </div>
    <!-- Gestionnaire des produits -->
    <div class="container mb-5 shadow rounded border p-3 bg-light-subtle">
      <h1 class="mb-1"><i class="fa-solid fa-pen me-3 fs-2"></i>Tableau des produits</h1>
      <h5 class="text-opacity-75 mb-3 border-bottom pb-3"><%- list_produit.length %> produit<%- list_produit.length > 1 ? "s" : "" %> dans votre liste</h5>
      <% if (list_produit == undefined || list_produit.length == 0) {%>
      <div class="alert alert-info mt-3 shadow">Votre gestion alimentaire est vide</div>
      <% } else { %>
      <div class="table-responsive">
        <table class="table table-striped border">
          <thead class="align-middle">
            <th scope="col">Produit</th>
            <th scope="col">Quantité</th>
            <th scope="col">Magasin</th>
            <th scope="col">Date d'achat</th>
            <th scope="col">Date d'expiration</th>
            <th scope="col">Etat du produit</th>
            <th scope="col">Actions</th>
          </thead>
          <tbody>
            <% for(i = 0; i < list_produit.length; i++){ %>
            <tr class="align-middle">
              <form>
                <td><span data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="<%- list_produit[i]['nom_categorie'] %>"><%- list_produit[i]['nom_produit'] %></span></td>
                <td><%- list_produit[i]['quantite'] %></td>
                <td><span data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="<%- list_produit[i]['nom_localite'] %>"><%- list_produit[i]['nom_magasin'] %></span></td>
                <td><%- date_local(list_produit[i]['date_achat']) %></td>
                <td><%- date_local(list_produit[i]['date_expiration']) %></td>
                <td><%- date_peremption_etat(list_produit[i]['date_expiration']) %></td>
                <td clas="">
                  <div class="d-flex gap-2">
                    <a href="#" class="btn btn-primary"><i class="fa-solid fa-pen"></i></a>
                    <a href="/supprimer-produit?id=<%- list_produit[i]['id_produit'] %>" class="btn btn-danger"><i class="fa-solid fa-trash"></i></a>
                  </div>
                </td>
              </form>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
  </div>
  <!-- Footer -->
  <%- include('../partials/footer') %>
  <!-- Footer -->
  <script>
    const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]')
    const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl))
  </script>
</body>

</html>