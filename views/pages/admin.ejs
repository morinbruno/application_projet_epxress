<!DOCTYPE html>
<html lang="fr" data-bs-theme="dark">
<%- include('../partials/head') %>

<body>
  <%- include('../partials/header') %>
  <div class="container mt-4">
    <div class="container mb-5 shadow rounded border p-3 pb-4 bg-light-subtle">

      <!-- Création d'utilisateur -->
      <h1 class="mb-3 border-bottom pb-3"><i class="fa-solid fa-user-plus fs-2 me-3"></i>Créer un utilisateur</h1>
      <form class="form-floating row m-0 mb-4 gap-3" method="post" action="/creer-compte">
          <!-- Pseudo -->
          <div class="col-sm p-0">
            <div class="input-group has-validation">
              <span class="input-group-text"><i class="fa-solid fa-user"></i></span>
              <div class="form-floating <%- pseudo_exist || pseudo_invalid || pseudo_short || pseudo_long ? "is-invalid" : "" %>">
                <input type="text" class="form-control <% if(pseudo_exist || pseudo_invalid || pseudo_short || pseudo_long) { %>is-invalid<% } %>" id="pseudo" name="pseudo" placeholder="Pseudo" minlength="3" maxlength="20" required>
                <label for="user_email">Pseudo</label>
              </div>
              <div class="invalid-feedback">
                <% if(pseudo_exist) { %>
                Pseudo déjà existant
                <% } else if (pseudo_invalid) { %>
                  Pseudo invalide
                <% } else if (pseudo_short) { %>
                  Pseudo trop court (=> 3)
                <% } else if(pseudo_long) { %>
                  Pseudo trop long (=< 20)
                <% } %>
              </div>
            </div>
          </div>
          <!-- Mot de passe -->
          <div class="col-sm p-0">
            <div class="input-group has-validation">
              <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
              <div class="form-floating <%- mdp_short || mdp_long || mdp_invalid ? "is-invalid" : "" %>">
                <input type="password" class="form-control <%- mdp_short || mdp_long || mdp_invalid ? "is-invalid" : "" %>" id="password" name="password" placeholder="Mot de passe" minlength="3" maxlength="20" required>
                <label for="password">Mot de passe</label>
              </div>
              <div class="invalid-feedback">
                <% if (mdp_invalid) { %>
                  Mot de passe invalide
                <% } else if (mdp_short) { %>
                  Mot de passe trop court (=> 3)
                <% } else if(mdp_long) { %>
                  Mot de passe trop long (=> 20)
                <% } %>
              </div>
            </div>
          </div>
        <!-- Email -->
        <div class="col-sm p-0">
          <div class="input-group has-validation">
            <span class="input-group-text"><i class="fa-solid fa-envelope"></i></span>
            <div class="form-floating <%= email_exist ? "is-invalid" : "" %>">
              <input type="email" class="form-control <%= email_exist ? "is-invalid" : "" %>" id="email" name="email" placeholder="name@example.com">
              <label for="user_email">Email</label>
            </div>
            <div class="invalid-feedback">
              <% if(email_exist) { %>
              Email déjà existant
              <% } %>
            </div>
          </div>
        </div>
        <div class="form-text p-0">
          Pseudo/Mot de passe égal ou compris entre 3 à 20 caractères.
        </div>
        <button type="submit" class="btn btn-primary col-auto">Ajouter un utilisateur</button>
      </form>

      <!-- Gestion utilisateur -->
      <div class="row row-cols-sm-auto gx-3 gy-3 justify-content-between mb-3 border-bottom pb-3 m-0 align-items-end">
        <div class="p-0">
          <h1 class="m-0"><i class="fa-solid fa-user-gear fs-2 me-3"></i>Gestion utilisateur</h1>
        </div>
        <!-- Barre de recherche -->
        <div class="p-0">
          <% if(list_users.length != 0 || username_search) { %>
            <form class="row row-cols-lg-auto" method="post" action="/admin">
              <div class="col-sm">
                <div class="input-group">
                  <input type="search" class="form-control" id="username_search" name="username_search" placeholder="Rechercher..." value="<%- username_search %>">
                  <button class="btn btn-secondary"><i class="fa-solid fa-magnifying-glass"></i></button>
                </div>
              </div>
            </form>
            <% } %>
        </div>
      </div>
      <!-- Tableau -->
      <% if (username_search && list_users.length == 0) { %>
        <div class="alert alert-info mt-3">Aucun utilisateur trouvé (<%-username_search %>)</div>
      <% } else if(list_users.length == 0) { %>
        <div class="alert alert-info mt-3">Aucun utilisateur d'enregistrer</div>
        <% } else { %>
      <div class="table-responsive">
        <table class="table table-striped border">
          <thead class="align-middle">
            <th scope="col">ID</th>
            <th scope="col">Pseudo</th>
            <th scope="col">Email</th>
            <th scope="col">Modifier le mot de passe</th>
            <th scope="col">Suppression</th>
          </thead>
          <tbody>
            <% for(let i=0; i < list_users.length; i++) { %>
            <tr class="align-middle">
              <td><%- list_users[i]['id_user'] %></td>
              <td><%- list_users[i]['user'] %></td>
              <td><%- list_users[i]['email'] ? list_users[i]['email'] : "Aucun email" %></td>
              <td style="width: 550px;">
                <form class="row align-items-center" style="width: 550px;" method="post" action="/password-update">
                  <div class="col-4">
                    <input type="password" placeholder="Mot de passe" class="form-control <%- password_different || password_short || password_long || password_invalid && id_user == list_users[i]['id_user'] ? "is-invalid" : "" %>" id="password" name="password" minlength="3" maxlength="20" required>
                    <div class="invalid-feedback mt-2 text-nowrap">
                      <% if (password_invalid && id_user == list_users[i]['id_user']) { %>
                        Mot de passe invalide !
                      <% } else if (password_invalid && id_user == list_users[i]['id_user']) { %>
                        Les mot de passes ne correspondent pas
                      <% } else if (password_long && id_user == list_users[i]['id_user']) { %>
                        Mot de passe trop long (=< 20)
                      <% } else if (password_short && id_user == list_users[i]['id_user']) { %>
                        Mot de passe trop court (=> 3)
                      <% } else if (password_different && id_user == list_users[i]['id_user']) { %>
                        Les mot de passes ne correspondent pas !
                      <% } %>
                    </div>
                  </div>
                  <div class="col-4">
                    <input type="password" placeholder="Répéter" class="form-control <% if(password_different || password_invalid && id_user == list_users[i]['id_user']) {"is-invalid"}%>" id="password_repeat" name="password_repeat" minlength="3" maxlength="20" required>
                    <div class="invalid-feedback mt-2">
                      <% if (password_invalid && id_user == list_users[i]['id_user']) { %>
                        &nbsp;
                      <% } else if (password_invalid && id_user == list_users[i]['id_user']) { %>
                        &nbsp;
                      <% } else if (password_long && id_user == list_users[i]['id_user']) { %>
                        &nbsp;
                      <% } else if (password_short && id_user == list_users[i]['id_user']) { %>
                        &nbsp;
                      <% } else if (password_different && id_user == list_users[i]['id_user']) { %>
                        &nbsp;
                      <% } %>
                    </div>
                  </div>
                  <div class="col-2">
                      <button class="btn btn-primary" value="<%- list_users[i]['id_user'] %>" name="id_user">Modifier</button>
                  </div>
                </form>
                <% %>
                <div>
                <% if (password_update_success && id_user == list_users[i]['id_user']) { %>
                  <div class="text-success mt-2">
                    Mot de passe mis à jour !
                  </div>
                <% } %>
              </td>
              <td>
                <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#modal-delete-user" id="button-delete-user">Supprimer</button>
                <!-- Modal -->
                <div class="modal fade" id="modal-delete-user" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                  <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                      <div class="modal-header">
                        <h1 class="modal-title fs-5" id="exampleModalLabel"><i class="fa-solid fa-warning me-3"></i>Avertissement</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                      </div>
                      <div class="modal-body">
                        Êtes-vous sûr de vouloir supprimer cet utilisateur ?
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                        <form method="post" action="/delete-user">
                          <button class="btn btn-danger" name="id_user" value="<%- list_users[i]['id_user'] %>"><i class="fa-solid fa-trash me-3"></i>Supprimer</button>
                        </form>
                      </div>
                    </div>
                  </div>
                </div>
              </td>
            </tr>
            <% } %>
            <% } %>
          </tbody>
        </table>
      </div>
      <div class="container mb-5 shadow rounded border p-3 pb-4 bg-light-subtle">
        <h1 class="mb-3 border-bottom pb-3"><i class="fa-solid fa-city fs-2 me-3"></i>Gestion localité</h1>
        <h1 class="mb-3 border-bottom pb-3"><i class="fa-solid fa-shop fs-2 me-3"></i>Gestion magasin</h1>
        <h1 class="mb-3 border-bottom pb-3"><i class="fa-solid fa-list fs-2 me-3"></i>Gestion catégorie</h1>
      </div>
    </div>
  </div>
  <%- include('../partials/footer') %>
</body>

</html>