<!-- Ajout d'un produit -->
<div class="container mb-5 shadow rounded border p-3 bg-light-subtle">
  <h1 class="mb-3 border-bottom pb-3"><i class="fa-solid fa-plus fs-2 me-3"></i>Ajouter un produit</h1>
  <form class="m-0 form-floating gap-3 mb-3" method="post" action="/ajouter-produit">
    <div class="row row-cols-md-2 m-0 mb-3 gap-3">
      <!-- Nom du produit -->
      <div class="form-floating p-0 col-md-3">
        <input type="text" class="form-control" placeholder="Produit" id="produit" name="produit" required>
        <label class="col-form-label" for="produit">Produit</label>
      </div>
      <!-- Quantité du produit -->
      <div class="col-md-3 p-0">
        <div class="input-group has-validation">
          <div class="form-floating <%- quantite_invalid ? "is-invalid" : "" %>">
            <input type="text" class="form-control <%- quantite_invalid ? "is-invalid" : "" %>" placeholder="Quantité" id="quantite" name="quantite" required>
            <label for="quantite">Quantité</label>
          </div>
          <div class="invalid-feedback">
            Quantité invalide !
          </div>
        </div>
      </div>
      <!-- Catégorie du produit -->
      <div class="form-floating p-0 col-md-3">
        <select class="form-select" id="categorie" name="categorie" aria-label="Catégorie">
          <% if (list_categorie.length == 0) { %>
          <option selected>Aucune catégorie disponible</option>
          <% } else { %>
          <option selected>Choississez la catégorie</option>
          <% for(i = 0; i < list_categorie.length; i++){ %>
          <option value="<%- list_categorie[i]['code_categorie'] %>"><%- list_categorie[i]['nom_categorie'] %></option>
          <% } %>
          <% } %>
        </select>
        <label for="categorie">Catégorie</label>
      </div>
      <!-- Date d'achat -->
      <div class="form-floating p-0 col-md-3">
        <input type="date" class="form-control" id="date_achat" name="date_achat" required>
        <label class="col-form-label" for="date_achat">Date d'achat</label>
      </div>
      <!-- Date d'expiration -->
      <div class="form-floating p-0 col-md-3">
        <input type="date" class="form-control" id="date_expiration" name="date_expiration" required>
        <label class="col-form-label" for="date_expiration">Date d'expiration</label>
      </div>
      <!-- Magasin -->
      <div class="form-floating p-0 col-md-3">
        <select class="form-select" id="magasin" name="magasin" aria-label="Magasin">
          <% if (list_magasin.length == 0) { %>
          <option selected>Aucun magasin disponible</option>
          <% } else { %>
          <option selected>Choississez le magasin</option>
          <% for(i = 0; i < list_magasin.length; i++){ %>
          <option value="<%- list_magasin[i]['id_magasin'] %>"><%- list_magasin[i]['nom_magasin'] %></option>
          <% } %>
          <% } %>
        </select>
        <label for="magasin">Magasin</label>
      </div>
      <!-- Ville du magasin -->
      <div class="form-floating p-0 col-md-3">
        <select class="form-select" id="localite" name="localite" aria-label="Localité">
          <% if (list_localite.length == 0) { %>
          <option selected>Aucune ville disponible</option>
          <% } else { %>
          <option selected>Choississez la ville</option>
          <% for(i = 0; i < list_localite.length; i++){ %>
          <option value="<%- list_localite[i]['code_postal'] %>"><%- list_localite[i]['nom_localite'] %></option>
          <% } %>
          <% } %>
        </select>
        <label for="localite">Ville</label>
      </div>
    </div>
    <!-- Bouton d'ajout du produit -->
    <div class="row row-cols-auto m-0 gap-3">
      <button type="submit" class="btn btn-primary" id="ajout_produit">Ajouter</button>
      <% if(produit_manquant) { %>
      <div class="alert alert-warning px-2 py-1 m-0 user-select-none"><i class="fa-solid fa-warning me-2"></i>Informations manquantes !</div>
      <% } %>
    </div>
  </form>
</div>