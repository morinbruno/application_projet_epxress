<!-- Gestion localités -->
<div class="container mb-5 shadow rounded border p-3 pb-4 bg-light-subtle" id="list_localites">
  <h1 class="mb-1"><i class="fa-solid fa-city fs-2 me-3"></i>Gestion localité</h1>
  <hr>
  <div>
    <h5 class="mb-3">Ajouter une localité</h5>
    <form class="row row-cols-lg-auto g-3 align-items-center" method="post" action="/ajouter-element" name="ajout_localite">
      <div class="col-auto">
        <input type="text" class="form-control" id="ajout_code_postal" name="ajout_code_postal" placeholder="Ex: 7700">
      </div>
      <div class="col-auto">
        <input type="text" class="form-control" id="ajout_localite" name="ajout_localite" placeholder="Ex: Mouscron">
      </div>
      <div class="col-auto">
        <button type="submit" class="btn btn-primary btn-sm">Ajouter</button>
      </div>
    </form>
  </div>
  <hr>
  <div>
    <h5 class="text-opacity-75"><%- list_localite.length %> localite<%- list_localite.length > 1 ? "s" : "" %> répertoriée<%- list_localite.length > 1 ? "s" : "" %></h5>
    <% if(list_localite.length == 0) { %>
    <div class="alert alert-info mt-3 user-select-none">Aucune localité d'enregistrée</div>
    <% } else { %>
    <div class="table-responsive">
      <table class="table table-striped border">
        <thead>
          <tr>
            <th scope="col">Code postal et Localité</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody class="table-group-divider">
          <% for(let i=0; i < list_localite.length; i++) { %>
          <tr class="align-middle">
            <td>
              <% if(find_name_localite(list_localite[i]['nom_localite'],nbr_localite_use).nbr_produits_localite > 0) { %>
              <div class="d-flex gap-3">
                <input type="text" value="<%- list_localite[i]['code_postal'] %>" class="form-control w-auto" style="cursor: not-allowed" disabled>
                <input type="text" value="<%- list_localite[i]['nom_localite'] %> " class="form-control w-auto" style="cursor: not-allowed" disabled>
              </div>
              <% } else { %>
              <form id="form-mod-localite-<%- list_localite[i]['code_postal'] %>" class="d-flex gap-3" method="post" action="/modifier-element">
                <input type="text" value="<%- list_localite[i]['code_postal'] %>" class="form-control w-auto" name="mod_code_postal" minlength="4" maxlength="5" required>
                <input type="text" value="<%- list_localite[i]['nom_localite'] %>" class="form-control w-auto" name="mod_localite" minlength="1" required>
              </form>
              <% } %>
            </td>
            <td>
              <% if(find_name_localite(list_localite[i]['nom_localite'],nbr_localite_use).nbr_produits_localite > 0) { %>
              <div class="d-flex gap-3">
                <div style="cursor: not-allowed">
                  <span data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Impossible">
                    <button class="btn btn-primary" name="mod_localite" disabled><i class="fa-solid fa-pen"></i></button>
                  </span>
                </div>
                <div style="cursor: not-allowed">
                  <span data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Impossible">
                    <button class="btn btn-danger" name="supp_localite" disabled><i class="fa-solid fa-trash"></i></button>
                  </span>
                </div>
              </div>
              <% } else { %>
              <div class="d-flex gap-3">
                <div>
                  <span data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Modifier">
                    <button type="submit" form="form-mod-localite-<%- list_localite[i]['code_postal'] %>" class="btn btn-primary" value="<%- list_localite[i]['code_postal'] %>" name="mod_localite_id"><i class="fa-solid fa-pen"></i></button>
                  </span>
                </div>
                <div>
                  <form method="post" action="/supprimer-element">
                    <span data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Supprimer">
                      <button type="submit" class="btn btn-danger" value="<%- list_localite[i]['code_postal'] %>" name="supp_localite"><i class="fa-solid fa-trash"></i></button>
                    </span>
                  </form>
                </div>
              </div>
              <% } %>
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>

