<header class="shadow border-bottom px-lg-4 py-2 bg-body-tertiary">
  <nav class="navbar navbar-expand-lg" aria-label="Offcanvas navbar large">
    <div class="container-fluid">
      <div class="d-block">
        <%- include('../partials/change_theme') %>
      </div>
      <h2 class="btn btn-success m-0">Session active : <%- req.session.username %></h2>
      <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar2" aria-controls="offcanvasNavbar2" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasNavbar2" aria-labelledby="nav-bar-mobile">
        <div class="offcanvas-header border-bottom">
          <h5 class="offcanvas-title" id="nav-bar-mobile">Menu</h5>
          <button type="button" class="btn-close btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
          <ul class="navbar-nav justify-content-end flex-grow-1 pe-3">
            <% for (let i = 0; i < nav.length; i++) { %>
                <% if(nav[i].title == title && nav[i].display == true) { %>
                    <li class="nav-item">
                        <a class="nav-link active" aria-current="page" href="<%- nav[i].url %>"><i class="me-2 <%- nav[i].icon %>"></i><%- nav[i].title %></a>
                    </li>
                    
                <% } else if (nav[i].type_user == req.session.typeuser && nav[i].display == true && nav[i].title == title) { %>
                    <li class="nav-item">
                        <a class="nav-link active" aria-current="page" href="<%- nav[i].url %>"><i class="me-2 <%- nav[i].icon %>"></i><%- nav[i].title %></a>
                    </li>
                <% } else if (nav[i].type_user == req.session.typeuser && nav[i].display == true) { %>
                    <li class="nav-item">
                        <a class="nav-link" aria-current="page" href="<%- nav[i].url %>"><i class="me-2 <%- nav[i].icon %>"></i><%- nav[i].title %></a>
                    </li>
                <% } else if (nav[i].type_user == "Utilisateur" && nav[i].display == true) { %>
                    <li class="nav-item">
                        <a class="nav-link" aria-current="page" href="<%- nav[i].url %>"><i class="me-2 <%- nav[i].icon %>"></i><%- nav[i].title %></a>
                    </li>
                <% } %>
            <% } %>
          </ul>
          <form method="get" action="/se-deconnecter" class="d-flex mt-3 mt-lg-0">
            <button type="submit" class="btn btn-danger"><i class="fa-solid fa-right-from-bracket me-2"></i>Se déconnecter</button>
          </form>
        </div>
      </div>
    </div>
  </nav>
</header>